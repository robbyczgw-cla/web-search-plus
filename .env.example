# Web Search Plus v4.0.0
# Copy to .env and fill in any providers you want.
# One credential (or SEARXNG_INSTANCE_URL) is enough to start.
# More providers = better routing/fallback/extraction coverage.
#
# PRIVACY NOTE: search queries and extraction URLs are sent to the providers
# you configure below. Results and provider failure history are cached locally
# under .cache (see WSP_* settings at the bottom of this file).

export SERPER_API_KEY=
# https://serper.dev — Google-style general web, shopping, local

export BRAVE_API_KEY=
# https://brave.com/search/api/ — independent web index
# Optional Brave tuning:
# export BRAVE_COUNTRY=US
# export BRAVE_SEARCH_LANG=en
# export BRAVE_SAFESEARCH=moderate

export TAVILY_API_KEY=
# https://tavily.com — research-focused search and extraction

export QUERIT_API_KEY=
# https://querit.ai — multilingual / international AI search

export LINKUP_API_KEY=
# https://linkup.so — source-grounded search and extraction

export EXA_API_KEY=
# https://exa.ai — semantic search, discovery, extraction

export FIRECRAWL_API_KEY=
# https://www.firecrawl.dev/app/api-keys — search + extraction

export YOU_API_KEY=
# https://api.you.com — current-web and content extraction

export SEARXNG_INSTANCE_URL=
# Self-hosted SearXNG URL, e.g. http://localhost:8080 or https://search.example.com
# Optional override only if you intentionally use a private-network instance:
# export SEARXNG_ALLOW_PRIVATE=1

export SERPBASE_API_KEY=
# https://serpbase.dev — low-cost Google SERP API with prepaid credits.
# Explicit/fallback-only by design (not in default auto-routing). Use:
#   python3 scripts/search.py -p serpbase -q "your query"
# OR add "serpbase" to auto_routing.provider_priority in config.json to opt-in.

export KEENABLE_API_KEY=
# https://keenable.ai — independent web index (search + extraction).
# Lowest auto-routing priority: never displaces a configured keyed provider.
# Keyless opt-in alternative (shared public tier, ~1000 req/hour, no SLA):
# export WSP_KEENABLE_ALLOW_PUBLIC=1

# --- Skill behavior settings (all optional) ---

# export WSP_LOCALE_COUNTRY=at
# export WSP_LOCALE_LANGUAGE=auto
# Default country/language for locale-aware providers (Serper, Brave, Querit,
# Firecrawl, You.com, SearXNG). "auto" language enables conservative query
# language inference; explicit location hints in queries override the country.

# export WSP_EXTRACT_CHAR_LIMIT=15000
# Inline extraction budget per URL; oversized pages return a head/tail window.

# export WSP_CACHE_DIR=/path/to/cache
# Where cached results, provider_health.json, and provider_stats.json (adaptive
# routing performance samples) are stored (.cache by default).
# Created with mode 0700; cache files are written mode 0600.

# export WSP_DISABLE_CACHE=1
# Disable local result caching entirely (equivalent to --no-cache on every call).

# export WSP_ALLOW_PRIVATE_URLS=1
# Allow user-supplied URLs (extraction, --similar-url) that resolve to
# private/internal networks. OFF by default; cloud metadata endpoints
# (169.254.169.254, metadata.google.internal) stay blocked either way.
